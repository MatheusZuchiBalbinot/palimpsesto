# Copy to .env and adjust as needed. .env is gitignored.
# docker compose reads this file automatically to substitute ${VAR} in
# docker-compose.yml — no need for "source" or a manual export.

POSTGRES_USER=palimpsesto
POSTGRES_PASSWORD=palimpsesto
POSTGRES_DB=palimpsesto

PALIMPSESTO_ADDR=:8080
# Dev-only value. Generate a real secret for anything that isn't your laptop:
# openssl rand -base64 32
PALIMPSESTO_JWT_SECRET=dev-only-secret-change-me-please-32b
