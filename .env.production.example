# Copy to .env.production on the deploy host and fill in real values —
# never commit the copy (.env* is gitignored). Unlike .env (which
# `docker compose` reads automatically), a differently-named file has to
# be passed explicitly:
#
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every value here needs to be a real production value — none of these
# have (or should have) a safe default, unlike .env.example's dev
# convenience values.

POSTGRES_USER=palimpsesto
# A real, unique password — not the dev default. Postgres's own volume
# only initializes on first run, so changing this after the volume exists
# needs an actual password change in Postgres too, not just here.
POSTGRES_PASSWORD=
POSTGRES_DB=palimpsesto

PALIMPSESTO_ADDR=:8080
# Required — docker-compose.prod.yml fails the `docker compose` invocation
# itself if this is empty, and server/internal/config/config.go refuses to
# boot without one too (and rejects anything under 32 bytes). Generate one
# with:
#   openssl rand -base64 32
PALIMPSESTO_JWT_SECRET=
